# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Connection (SQLite local or PostgreSQL)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/shramikid?schema=public"

# Authentication & Security
JWT_SECRET="shramikid_super_secret_jwt_key_2026_bd_secure_token"
JWT_EXPIRES_IN="7d"

# SMS Gateway Configuration (Greenweb, BulkSMSBD, or Sandbox)
SMS_GATEWAY_PROVIDER="sandbox" # Options: sandbox | greenweb | bulksmsbd
SMS_API_KEY="your_api_key_here"
SMS_SENDER_ID="ShramikID"
